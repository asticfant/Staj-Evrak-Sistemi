@model KayitFormu
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 mb-1">Kayıt Ol</h2>
                <p class="text-muted mb-4">Kişisel bilgilerini kayıttan sonra profil sayfasında gireceksin.</p>

                @* method="post" olduğu için tag helper anti-forgery token'ı otomatik ekler
                   (controller [ValidateAntiForgeryToken] istiyor). *@
                <form asp-action="Kayit" method="post" novalidate>
                    @* Servisten gelen genel hatalar (örn. "Bu kullanıcı adı kullanılıyor") burada görünür. *@
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="KullaniciAdi" class="form-label">Kullanıcı adı</label>
                        <input asp-for="KullaniciAdi" class="form-control" autocomplete="username" />
                        <span asp-validation-for="KullaniciAdi" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-posta</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Sifre" class="form-label">Şifre</label>
                        <input asp-for="Sifre" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Sifre" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SifreTekrar" class="form-label">Şifre (tekrar)</label>
                        <input asp-for="SifreTekrar" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="SifreTekrar" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Kayıt Ol</button>
                </form>

                <p class="text-center mt-3 mb-0">
                    Zaten hesabın var mı? <a asp-action="Giris">Giriş yap</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Boş veya hatalı alanlar sunucuya gitmeden tarayıcıda uyarı versin. *@
    <partial name="_ValidationScriptsPartial" />
}
