@{
    ViewData["Title"] = "Erişim engellendi";
    // Controller bu sayfayı 403 (Forbidden) durum koduyla döndürür.
    // Buraya, giriş yapmış ama sayfa için yetkisi olmayan kullanıcı gelir
    // (örn. öğrenci /Admin/Belgeler adresini elle yazarsa).
}

<div class="dar-sayfa">
    <div class="kagit">
        <p class="hata-kodu mb-2">403</p>
        <h1 class="h2">Bu sayfa senin hesabına kapalı</h1>
        <p class="text-secondary">
            Açmaya çalıştığın sayfa başka bir kullanıcı rolüne ait. Farklı bir hesapla
            girmen gerekiyorsa önce çıkış yap, sonra o hesapla giriş yap.
        </p>
        <p class="text-secondary small mb-0">5 saniye içinde giriş sayfasına yönlendirileceksin.</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Giris">Giriş sayfası</a>
        </div>
    </div>
</div>
