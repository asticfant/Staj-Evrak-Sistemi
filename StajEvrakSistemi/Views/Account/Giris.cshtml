@model GirisFormu
@{
    ViewData["Title"] = "Giriş yap";

    // returnUrl: kullanıcı giriş yapmadan korumalı bir sayfayı açmaya çalıştıysa,
    // giriş sonrası oraya geri dönsün diye adresi saklıyoruz.
    // İlk açılışta ViewData'dan, hatalı denemeden sonra adres çubuğundan gelir.
    var returnUrl = ViewData["ReturnUrl"] as string ?? Context.Request.Query["returnUrl"].ToString();
}

<div class="dar-sayfa">
    <header class="sayfa-baslik">
        <h1>Giriş yap</h1>
        <p>Kullanıcı adın ya da e-posta adresinle giriş yapabilirsin.</p>
    </header>

    <div class="kagit">
        @* method="post" olduğu için tag helper anti-forgery token'ı otomatik ekler
           (controller [ValidateAntiForgeryToken] istiyor). *@
        <form asp-action="Giris" asp-route-returnUrl="@returnUrl" method="post" novalidate>
            @* "Kullanıcı adı veya şifre hatalı", "Hesabınız kilitli" gibi mesajlar burada görünür. *@
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="KullaniciAdiVeyaEmail" class="form-label">Kullanıcı adı veya e-posta</label>
                <input asp-for="KullaniciAdiVeyaEmail" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="KullaniciAdiVeyaEmail" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Sifre" class="form-label">Şifre</label>
                <input asp-for="Sifre" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Sifre" class="text-danger small"></span>
                <div class="form-text">5 hatalı denemede hesap 15 dakika kilitlenir.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Giriş yap</button>
        </form>
    </div>

    <p class="text-center mt-3">
        Hesabın yok mu? <a asp-action="Kayit">Hesap oluştur</a>
    </p>
</div>

@section Scripts {
    @* Boş alanlar sunucuya gitmeden tarayıcıda uyarı versin. *@
    <partial name="_ValidationScriptsPartial" />
}
