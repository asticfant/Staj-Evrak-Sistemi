@model List<Document>
@{
    ViewData["Title"] = "Belgelerim";
}

<div class="baslik-satiri">
    <header class="sayfa-baslik">
        <h1>Belgelerim</h1>
        <p>Yüklediğin Ek-16 belgeleri ve kontrol durumları. En yeni belge en üstte.</p>
    </header>
    <a class="btn btn-primary" asp-action="EvrakYukle"><i class="bi bi-upload me-1"></i>Yeni belge yükle</a>
</div>

<div class="kagit p-0">
    @if (Model.Count == 0)
    {
        <div class="bos-durum">
            <i class="bi bi-folder2" aria-hidden="true"></i>
            <p class="mb-3">Henüz belge yüklemedin.</p>
            <a class="btn btn-outline-primary" asp-action="EvrakYukle">Ek-16 yükle</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Yüklenme</th>
                        <th>Dosya</th>
                        <th>Staj dönemi</th>
                        <th>Durum</th>
                        <th><span class="visually-hidden">İşlem</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var belge in Model)
                    {
                        <tr>
                            @* Tarih veritabanında UTC tutuluyor; ekranda yerel saate çevriliyor. *@
                            <td>@belge.YuklenmeTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@belge.DosyaTuru.ToString().ToUpperInvariant()</td>
                            <td>
                                @if (belge.StajBilgisi is not null)
                                {
                                    @($"{belge.StajBilgisi.StajBaslangic:dd.MM.yyyy} – {belge.StajBilgisi.StajBitis:dd.MM.yyyy}")
                                }
                                else
                                {
                                    <span class="text-secondary">–</span>
                                }
                            </td>
                            <td><partial name="_DurumRozeti" model="belge.Durum" /></td>
                            <td class="text-end">
                                <a asp-action="Rapor" asp-route-documentId="@belge.Id">Raporu gör</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
