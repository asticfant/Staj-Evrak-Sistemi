<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Staj Evrak Sistemi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StajEvrakSistemi.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        // Rol bilgisi giriş sırasında cookie'ye claim olarak yazılır (AuthService.ClaimsOlustur).
        // User.IsInRole o claim'e bakar; veritabanına gitmez.
        var girisYapti = User.Identity?.IsAuthenticated == true;
        var adminMi = User.IsInRole(nameof(UserRole.Admin));
        var ogrenciMi = User.IsInRole(nameof(UserRole.Student));
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Staj Evrak Sistemi</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (ogrenciMi)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Profil">Profil</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="EvrakYukle">Evrak Yükle</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Belgelerim">Belgelerim</a></li>
                        }
                        else if (adminMi)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Belgeler">Belgeler</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Tamamlananlar">Tamamlananlar</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="VeriSetiYukle">Veri Seti Yükle</a></li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (girisYapti)
                        {
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    @(User.Identity?.Name)
                                    <small class="opacity-75">(@(adminMi ? "Admin" : "Öğrenci"))</small>
                                </span>
                            </li>
                            <li class="nav-item">
                                @* Çıkış bir link değil POST formu: başka bir sayfadaki gizli bir link
                                   kullanıcıyı habersizce çıkış yaptıramasın.
                                   method="post" olan form tag helper'ı anti-forgery token'ı kendisi ekler. *@
                                <form asp-controller="Account" asp-action="Cikis" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm mt-1">Çıkış</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Giris">Giriş</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Kayit">Kayıt Ol</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Mesaj" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 – Staj Evrak Doğrulama ve Yönetim Sistemi
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
