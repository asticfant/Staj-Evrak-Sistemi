@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
    // Bu sayfa sadece Development dışındaki ortamlarda görünür (Program.cs: UseExceptionHandler).
    // Geliştirirken hatanın ayrıntısını Visual Studio'nun hata sayfası gösterir.
}

<div class="dar-sayfa">
    <div class="kagit">
        <p class="hata-kodu mb-2">500</p>
        <h1 class="h2">İşlem tamamlanamadı</h1>
        <p class="text-secondary">Sunucuda beklenmeyen bir hata oluştu. Sayfayı yenileyip tekrar dene; sorun sürerse admin'e bildir.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="small text-secondary mb-0">İstek kimliği: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana sayfaya dön</a>
        </div>
    </div>
</div>
